{
  "skill_name": "token-optimizer",
  "version": "1.0.0",
  "evals": [
    {
      "id": 1,
      "prompt": "帮我分析一下当前的token使用情况",
      "expected_output": "执行analyze模式，输出token统计和优化建议",
      "assertions": [
        {"id": "a1", "text": "应显示当前token使用统计"},
        {"id": "a2", "text": "应提供优化建议"},
        {"id": "a3", "text": "应使用headroom进行分析"}
      ]
    },
    {
      "id": 2,
      "prompt": "对话太长了，帮我压缩一下",
      "expected_output": "执行compress模式，输出压缩报告",
      "assertions": [
        {"id": "a1", "text": "应调用headroom进行压缩"},
        {"id": "a2", "text": "应显示压缩前后的token数量"},
        {"id": "a3", "text": "应显示节省比例"},
        {"id": "a4", "text": "应保存压缩历史"}
      ]
    },
    {
      "id": 3,
      "prompt": "我想看看这个月的token使用报告",
      "expected_output": "执行report模式，输出详细的统计报告",
      "assertions": [
        {"id": "a1", "text": "应显示总体统计数据"},
        {"id": "a2", "text": "应显示分时段统计"},
        {"id": "a3", "text": "应显示趋势图表"},
        {"id": "a4", "text": "应显示优化建议"}
      ]
    },
    {
      "id": 4,
      "prompt": "节省token",
      "expected_output": "触发token-optimizer skill",
      "assertions": [
        {"id": "a1", "text": "应正确触发skill"},
        {"id": "a2", "text": "应提供操作选项"}
      ]
    },
    {
      "id": 5,
      "prompt": "token太多怎么办",
      "expected_output": "触发token-optimizer skill并提供建议",
      "assertions": [
        {"id": "a1", "text": "应正确触发skill"},
        {"id": "a2", "text": "应提供压缩建议"}
      ]
    },
    {
      "id": 6,
      "prompt": "帮我写一个token验证函数",
      "expected_output": "不触发token-optimizer skill",
      "assertions": [
        {"id": "a1", "text": "不应触发token-optimizer skill"},
        {"id": "a2", "text": "应按正常流程处理"}
      ]
    },
    {
      "id": 7,
      "prompt": "压缩上下文",
      "expected_output": "执行compress模式",
      "assertions": [
        {"id": "a1", "text": "应正确识别关键词"},
        {"id": "a2", "text": "应执行压缩操作"}
      ]
    },
    {
      "id": 8,
      "prompt": "token报告",
      "expected_output": "执行report模式",
      "assertions": [
        {"id": "a1", "text": "应正确识别关键词"},
        {"id": "a2", "text": "应生成报告"}
      ]
    },
    {
      "id": 9,
      "prompt": "优化成本",
      "expected_output": "触发token-optimizer skill",
      "assertions": [
        {"id": "a1", "text": "应正确触发skill"},
        {"id": "a2", "text": "应提供建议"}
      ]
    },
    {
      "id": 10,
      "prompt": "降低成本",
      "expected_output": "触发token-optimizer skill",
      "assertions": [
        {"id": "a1", "text": "应正确触发skill"},
        {"id": "a2", "text": "应提供建议"}
      ]
    }
  ],
  "edge_cases": [
    {
      "id": "e1",
      "prompt": "",
      "expected_output": "应提示输入内容或使用默认模式",
      "assertions": [
        {"id": "a1", "text": "应处理空输入"}
      ]
    },
    {
      "id": "e2",
      "prompt": "token",
      "expected_output": "可能触发skill，应提供清晰的选项",
      "assertions": [
        {"id": "a1", "text": "应正确处理模糊输入"}
      ]
    },
    {
      "id": "e3",
      "prompt": "headroom没装怎么办",
      "expected_output": "应提供安装指导或自动安装",
      "assertions": [
        {"id": "a1", "text": "应处理依赖缺失情况"}
      ]
    }
  ],
  "known_issues": [
    {
      "id": "k1",
      "description": "headroom安装可能需要较长时间",
      "workaround": "提前安装headroom-ai"
    },
    {
      "id": "k2",
      "description": "压缩可能不适用于所有内容类型",
      "workaround": "使用可逆压缩，保留原始数据"}
  ]
}
