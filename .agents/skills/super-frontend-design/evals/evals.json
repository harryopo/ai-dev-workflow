{
  "skill": "super-frontend-design",
  "version": "2.8.0",
  "evals": [
    {
      "id": "core-001",
      "category": "core",
      "subcommand": "creative",
      "prompt": "帮我生成一个有机湍流风格的flow field生成艺术",
      "expected_routing": "creative",
      "expected_output": ["哲学宣言.md", "交互式HTML文件", "p5.js种子随机", "参数控件"],
      "anti_pattern": ["不应从零创建HTML", "不应使用系统字体"]
    },
    {
      "id": "core-002",
      "category": "core",
      "subcommand": "design",
      "prompt": "设计一个SaaS产品的Dashboard页面",
      "expected_routing": "design",
      "expected_output": ["视觉方向选择", "Design Token系统", "可运行代码", "响应式布局"],
      "anti_pattern": ["不应使用通用SaaS卡片网格", "不应使用原始hex值"]
    },
    {
      "id": "boundary-001",
      "category": "boundary",
      "subcommand": "creative",
      "prompt": "做一个海报，但要有交互性",
      "expected_routing": "creative（需确认模式）",
      "expected_output": ["询问用户选择生成艺术模式还是视觉设计模式"],
      "anti_pattern": ["不应自动选择模式而不询问"]
    },
    {
      "id": "boundary-002",
      "category": "boundary",
      "subcommand": "design",
      "prompt": "设计一个landing page，但要暗色模式",
      "expected_routing": "design + theme",
      "expected_output": ["暗色模式Design Token", "暗色对比度验证"],
      "anti_pattern": ["暗色模式不应只是颜色反转"]
    },
    {
      "id": "edge-001",
      "category": "edge",
      "subcommand": "review",
      "prompt": "审查这个完全没有样式的纯HTML页面",
      "expected_routing": "review",
      "expected_output": ["多维度审查报告", "低分评分", "改进建议列表"],
      "anti_pattern": ["不应给出高分"]
    },
    {
      "id": "edge-002",
      "category": "edge",
      "subcommand": "theme",
      "prompt": "给我一个赛博朋克风格的主题，但要用在医疗App上",
      "expected_routing": "theme",
      "expected_output": ["自定义主题生成", "提示风格与行业不匹配的风险", "提供替代建议"],
      "anti_pattern": ["不应盲目生成不考虑适用性"]
    },
    {
      "id": "creative-001",
      "category": "creative",
      "subcommand": "creative",
      "prompt": "用代码画一个受日本枯山水启发的生成艺术",
      "expected_routing": "creative",
      "expected_output": ["枯山水哲学宣言", "p5.js沙纹算法", "种子随机", "极简参数"],
      "anti_pattern": ["不应照搬flow field示例"]
    },
    {
      "id": "creative-002",
      "category": "creative",
      "subcommand": "creative",
      "prompt": "做一张关于量子计算的博物馆级海报",
      "expected_routing": "creative（视觉设计模式）",
      "expected_output": ["量子哲学宣言", "PDF/PNG输出", "90%视觉10%文字", "博物馆品质"],
      "anti_pattern": ["不应卡通化", "不应文字过多"]
    },
    {
      "id": "design-001",
      "category": "design",
      "subcommand": "design",
      "prompt": "用shadcn/ui构建一个设置页面，包含表单验证",
      "expected_routing": "design",
      "expected_output": ["shadcn/ui组件", "FieldGroup模式", "表单验证", "语义Token"],
      "anti_pattern": ["不应使用space-y-*布局", "不应使用原始Input而非InputGroup"]
    },
    {
      "id": "design-002",
      "category": "design",
      "subcommand": "design",
      "prompt": "做一个全流程：从灵感探索到最终审查，主题是AI搜索产品",
      "expected_routing": "research → design-context → creative → theme → design → review",
      "expected_output": ["六阶段顺序执行（先 research 调研产出 Design Brief）", "Design Token贯穿", "审查报告"],
      "anti_pattern": ["不应跳过任何阶段", "不应各阶段风格不一致"]
    },
    {
      "id": "v28-001",
      "category": "core",
      "subcommand": "design",
      "prompt": "帮我做一个内部运营管理后台，带数据表格和审批流",
      "expected_routing": "research → design-context → design（加载 Part 17 与 references/admin-enterprise-patterns.md）",
      "expected_output": ["B端布局模板起步", "表格/筛选/批量操作模式", "企业级组件库选型"],
      "anti_pattern": ["不应直接输出通用SaaS模板", "不应跳过admin-enterprise模式库"]
    },
    {
      "id": "v28-002",
      "category": "core",
      "subcommand": "design-context",
      "prompt": "用 TDesign 的风格初始化这个项目的设计上下文",
      "expected_routing": "design-context（引用 design-systems/tdesign.md 预设作为种子）",
      "expected_output": ["9-section DESIGN.md", "--td-* 变量映射", "提示预设需经调研校准"],
      "anti_pattern": ["不应跳过调研直接复制预设", "不应把预设基线色当成最终品牌色"]
    },
    {
      "id": "v28-003",
      "category": "boundary",
      "subcommand": "design",
      "prompt": "优化一下这个后台页面的排版层级",
      "expected_routing": "research（重新调研）→ design-context → design，不是 review",
      "expected_output": ["重新调研字号与交互节奏", "按 admin-enterprise 模式重排层级"],
      "anti_pattern": ["不应路由到review只给评分", "不应跳过调研直接改样式"]
    }
  ]
}
